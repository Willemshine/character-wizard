{
  "name": "character-wizard",
  "version": "0.1.0",
  "description": "Character creation wizard for tabletop RPGs with D&D 2014 and 2024 edition support",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "character",
    "wizard",
    "dnd",
    "5e",
    "rpg",
    "tabletop"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
